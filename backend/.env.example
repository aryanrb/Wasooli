PORT=8080
DATABASE_URL=postgres://postgres:postgres@localhost:5432/wasooli?sslmode=disable
RUNTIME_ENV=dev
JWT_SECRET=dev-secret-change-me

# SPA origin: used for CORS and the post-login redirect.
FRONTEND_URL=http://localhost:5173

# Google OAuth — create credentials at https://console.cloud.google.com/apis/credentials
# Authorized redirect URI must match GOOGLE_REDIRECT_URL exactly.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URL=http://localhost:8080/api/v1/auth/google/callback
